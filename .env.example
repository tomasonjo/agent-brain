NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

DIFFBOT_API_KEY=
ANTHROPIC_API_KEY=

BRAIN_TZ=Europe/Ljubljana
BRAIN_MAX_ACTIVE_TRIGGERS=20
BRAIN_MODEL=claude-sonnet-4-6

BRAIN_JOBSTORE=.brain/jobstore.sqlite
BRAIN_TRIGGERS_DIR=triggers

# Dream phase
BRAIN_DREAM_ON_STOP=1                # 0 to disable auto-dream from Stop hook
BRAIN_DREAM_DEBOUNCE_SECONDS=60      # min gap between dreams of the same session
